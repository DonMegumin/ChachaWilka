@model ComboVM
@{
    ViewData["Title"] = "Armar caja";
    var puedeArmar = Model.Precio > 0 && Model.Productos.Count >= (Model.Repeticiones ? 1 : 4)
        && Model.Productos.Sum(p => p.Disponible) >= 4;
    var nombre = Model.Categoria.ToLowerInvariant();
    var fotoCaja = Model.Categoria == CatalogoMarca.Cremas ? "caja-cremas.webp" : "caja-licores.webp";
}
<section class="marco pagina configurar-caja">
    <a class="regreso" asp-controller="Home" asp-action="Index" asp-fragment="cajas">← Volver a las cajas</a>
    <header class="configurar-cabecera">
        <div>
            <h1>Caja de @nombre</h1>
            <p>@(Model.Repeticiones ? "Elige cuatro botellas. Puedes repetir sabores si hay existencias." : "Elige cuatro sabores distintos para tu caja.")</p>
        </div>
        @if (Model.Precio > 0)
        {
            <p class="precio-destacado">S/ @Model.Precio.ToString("0.00")</p>
        }
    </header>
    @if (puedeArmar)
    {
        <form asp-action="AgregarCombo" method="post" class="configurador" data-combo data-repeticiones="@Model.Repeticiones.ToString().ToLowerInvariant()">
            <input type="hidden" name="categoria" value="@Model.Categoria" />
            <div>
                <div class="selector-sabores" data-selector-sabores hidden>
                    @foreach (var producto in Model.Productos)
                    {
                        <button type="button" class="elegir-sabor" data-elegir="@producto.Id_Producto">
                            @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                            {
                                <img src="~/images/chachawillka/@producto.Imagen" alt="" width="640" height="585" loading="lazy" />
                            }
                            else
                            {
                                <span class="marca marca-sola" aria-hidden="true">Chacha<i>Willka</i></span>
                            }
                            <span class="elegir-nombre"><span>@producto.Nombre</span><span class="elegir-signo" aria-hidden="true">+</span></span>
                            <span class="solo-lectura" data-seleccionadas></span>
                        </button>
                    }
                </div>
                <div class="selecciones" data-seleccion-nativa>
                    @for (var i = 1; i <= 4; i++)
                    {
                        <div>
                            <label for="sabor-@i">Sabor @i</label>
                            <select id="sabor-@i" name="seleccion" required>
                                <option value="">Seleccionar</option>
                                @foreach (var producto in Model.Productos)
                                {
                                    var foto = string.IsNullOrWhiteSpace(producto.Imagen) ? null : Url.Content("~/images/chachawillka/" + producto.Imagen);
                                    <option value="@producto.Id_Producto" data-unidades="@producto.Disponible" data-foto="@foto">@producto.Nombre</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
            <aside class="resumen-caja" aria-labelledby="tu-seleccion">
                <h2 id="tu-seleccion">Tu caja</h2>
                <p class="combo-progreso" role="status" data-progreso hidden>0 de 4 botellas</p>
                <div class="bandeja bandeja-elegible" data-bandeja hidden>
                    @for (var i = 1; i <= 4; i++)
                    {
                        <div class="hueco">
                            <span data-posicion aria-hidden="true">@i</span>
                            <button class="quitar-sabor" type="button" data-quitar="@i" hidden></button>
                        </div>
                    }
                </div>
                <button class="boton boton-primario" type="submit" data-agregar-caja>Añadir caja a la cesta <span class="flecha" aria-hidden="true"></span></button>
            </aside>
        </form>
    }
    else
    {
        <div class="caja-no-disponible">
            <img src="~/images/chachawillka/@fotoCaja" alt="Presentación referencial de la caja de @nombre" width="1200" height="800" />
            <div>
                <h2>Caja sin stock</h2>
                <p>Estará disponible cuando haya suficientes sabores en esta colección.</p>
                <a class="boton boton-secundario" asp-controller="Home" asp-action="Index" asp-route-categoria="@Model.Categoria" asp-fragment="coleccion">Ver @nombre en la colección</a>
            </div>
        </div>
    }
</section>
