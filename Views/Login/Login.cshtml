@model LoginVM
@{ ViewData["Title"] = "Ingresar"; }
<section class="marco pagina acceso">
    <figure class="acceso-foto"><img src="~/images/chachawillka/combo-licores-2.jpg" alt="Colección de licores artesanales" width="640" height="383" /></figure>
    <div class="panel">
        <h1>Ingresa a tu cuenta</h1>
        <form asp-action="Login" method="post" class="formulario">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validacion" role="alert"></div>
            <label asp-for="Correo">Correo electrónico</label>
            <input asp-for="Correo" type="email" autocomplete="email" required />
            <span asp-validation-for="Correo" class="validacion"></span>
            <label asp-for="Contraseña"></label>
            <input asp-for="Contraseña" autocomplete="current-password" required />
            <span asp-validation-for="Contraseña" class="validacion"></span>
            <button class="boton boton-primario" type="submit">Ingresar <span aria-hidden="true">↗</span></button>
        </form>
        <p>¿Primera vez? <a class="subrayado" asp-action="Registro">Crea una cuenta.</a></p>
    </div>
</section>
