@model IReadOnlyList<Producto>
@{
    ViewData["Title"] = "Catálogo e inventario";
    var categorias = (IReadOnlyList<Categoria>)ViewData["Categorias"]!;
}
<section class="marco pagina">
    <a class="regreso" asp-action="Index">← Administración</a>
    <div class="seccion-cabecera"><div><h1>Catálogo e inventario</h1></div><a class="boton boton-primario" asp-action="Producto">Nuevo producto +</a></div>
    <div class="tabla-scroll">
        <table>
            <thead><tr><th scope="col">Producto</th><th scope="col">Precio</th><th scope="col">Existencia</th><th scope="col">Reserva</th><th scope="col">Disponible</th><th scope="col">Inventario</th></tr></thead>
            <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <th scope="row"><a class="subrayado" asp-action="Producto" asp-route-id="@producto.Id_Producto">@producto.Nombre</a><br /><small>@producto.Categorias.Nombre_Categoria · @(producto.Activo && producto.Categorias.Activa ? "Visible" : "Oculto")</small></th>
                    <td>S/ @producto.Precio.ToString("0.00")</td><td>@producto.Stock</td><td>@producto.Reservado</td><td>@producto.Disponible</td>
                    <td><details><summary>Ajustar</summary>
                        <form asp-action="Stock" asp-route-id="@producto.Id_Producto" method="post" class="formulario formulario-tabla">
                            <label for="cantidad-@producto.Id_Producto">Cantidad (+ entrada, − salida)</label><input type="number" id="cantidad-@producto.Id_Producto" name="cantidad" required />
                            <label for="motivo-@producto.Id_Producto">Motivo</label><input id="motivo-@producto.Id_Producto" name="motivo" maxlength="200" required />
                            <button type="submit" class="boton boton-secundario">Registrar</button>
                        </form>
                    </details></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <section class="panel margen-superior">
        <h2>Categorías</h2>
        @foreach (var categoria in categorias)
        {
            <form asp-action="Categoria" asp-route-id="@categoria.Id_Categoria" method="post" class="form-linea categoria-admin">
                <label class="solo-lectura" for="categoria-@categoria.Id_Categoria">Nombre de @categoria.Nombre_Categoria</label>
                <input id="categoria-@categoria.Id_Categoria" name="nombre" value="@categoria.Nombre_Categoria" maxlength="50" required />
                <label class="casilla"><input type="checkbox" name="activa" value="true" checked="@categoria.Activa" /> Visible</label>
                <button type="submit" class="boton boton-secundario">Guardar</button>
            </form>
        }
        <form asp-action="Categoria" method="post" class="form-linea categoria-admin">
            <label for="nueva-categoria">Nueva categoría</label><input id="nueva-categoria" name="nombre" maxlength="50" required />
            <input type="hidden" name="activa" value="true" /><button type="submit" class="boton boton-secundario">Crear</button>
        </form>
    </section>
</section>
