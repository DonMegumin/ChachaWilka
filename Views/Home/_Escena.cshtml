<section class="escena" aria-label="Licores y cremas de Chachapoyas" data-escena>
    <h1 class="solo-lectura">ChachaWillka · Licores y cremas artesanales de Chachapoyas</h1>
    @foreach (var sabor in new[] {
        (Foto: "aguaymanto", Nombre: "Aguaymanto", Tipo: "Licores", Inicio: "Chachapoyas,", Final: "en una botella.", Descripcion: "Aguaymanto de notas ácidas y frutales. Descubre los licores artesanales de nuestra colección."),
        (Foto: "cafe", Nombre: "Café", Tipo: "Cremas", Inicio: "El carácter", Final: "del café.", Descripcion: "Café intenso y textura cremosa. Explora la colección de cremas artesanales de ChachaWillka.")
    })
    {
        var primera = sabor.Tipo == "Licores";
        <article class="escena-slide @(primera ? "actual" : null)" inert="@(!primera)" aria-hidden="@(!primera ? "true" : null)" data-slide>
            <picture class="escena-imagen">
                <source media="(max-width: 680px)" srcset="@Url.Content($"~/images/chachawillka/escena-{sabor.Foto}-movil.webp")" />
                <img src="@Url.Content($"~/images/chachawillka/escena-{sabor.Foto}.webp")" fetchpriority="@(primera ? "high" : "low")" width="1536" height="1024" alt="Botella ChachaWillka de @sabor.Nombre con sus ingredientes" />
            </picture>
            <div class="escena-copy">
                <h2>@sabor.Inicio <em>@sabor.Final</em></h2>
                <p>@sabor.Descripcion</p>
                <div class="escena-acciones">
                    <a class="boton boton-lima" asp-action="Coleccion" asp-route-categoria="@sabor.Tipo">Explorar @sabor.Tipo.ToLowerInvariant() <span class="flecha" aria-hidden="true"></span></a>
                    <a class="enlace-escena" href="#cajas">Ver cajas</a>
                </div>
            </div>
        </article>
    }
    <div class="escena-selector" aria-label="Cambiar sabor de portada" hidden>
        <button type="button" aria-pressed="true" data-escena-indice="0"><i></i>Aguaymanto</button>
        <button type="button" aria-pressed="false" data-escena-indice="1"><i></i>Café</button>
    </div>
</section>
