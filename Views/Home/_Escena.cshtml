@{
    var sabores = new[] {
        (Clave: "aguaymanto", Nombre: "Aguaymanto", Foto: "licor-aguaymanto.jpg", Nota: "Frutal, con un punto ácido.", Tipo: "Licor de fruta"),
        (Clave: "mora", Nombre: "Mora", Foto: "licor-mora.jpg", Nota: "El carácter de la mora.", Tipo: "Licor de fruta"),
        (Clave: "coco", Nombre: "Coco", Foto: "crema-coco.jpg", Nota: "Suave y cremoso.", Tipo: "Crema artesanal")
    };
}
<section class="escena" data-escena data-tono="aguaymanto" aria-labelledby="titulo-portada">
    <div class="marco escenario">
        <div class="relato">
            <p class="lugar"><span aria-hidden="true"></span> Chachapoyas · Perú</p>
            <h1 id="titulo-portada">Amazonas,<br /><em>en botella.</em></h1>
            <p class="introduccion">Licores y cremas artesanales de Chachapoyas. Descubre la colección, botella por botella.</p>
            <div class="enlaces-portada">
                <a class="boton boton-portada" href="#coleccion">Explorar sabores <span aria-hidden="true">↓</span></a>
                <a class="enlace-caja" href="#cajas">Ver las cajas <span aria-hidden="true">↗</span></a>
            </div>
        </div>
        <div class="muestra" data-muestra>
            <div class="orbita" aria-hidden="true"></div>
            @foreach (var sabor in sabores)
            {
                var primera = sabor == sabores[0];
                <figure class="lamina @sabor.Clave" data-lamina="@sabor.Clave" aria-hidden="@(!primera ? "true" : "false")">
                    <div class="ventana" aria-hidden="true"><img src="~/images/chachawillka/@sabor.Foto" alt="" width="640" height="585" decoding="async" /></div>
                    <div class="frasco"><img src="~/images/chachawillka/@sabor.Foto" alt="Botella ChachaWillka de @sabor.Nombre.ToLowerInvariant()" width="640" height="585" fetchpriority="@(primera ? "high" : "low")" /></div>
                    <figcaption><small>@sabor.Tipo</small><strong>@sabor.Nombre</strong><span>@sabor.Nota</span></figcaption>
                </figure>
            }
        </div>
    </div>
    <div class="marco mando-escena">
        <span class="leyenda-escena">Explora los sabores</span>
        <div class="muestras" role="group" aria-label="Sabor en portada">
            @foreach (var sabor in sabores)
            {
                <button type="button" data-sabor="@sabor.Clave" class="@sabor.Clave" aria-pressed="@(sabor == sabores[0] ? "true" : "false")"><i aria-hidden="true"></i>@sabor.Nombre</button>
            }
        </div>
        <a class="bajar" href="#coleccion" aria-label="Bajar a la colección">↓</a>
    </div>
    <span class="solo-lectura" data-lectura-escena role="status"></span>
</section>
