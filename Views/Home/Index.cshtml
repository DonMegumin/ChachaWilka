@model PortadaVM
@{
    ViewData["Title"] = "Licores y cremas de Chachapoyas";
    ViewData["Portada"] = true;
    var personal = User.IsInRole(RolesTienda.Administrador) || User.IsInRole(RolesTienda.Empleado);
    var cajas = new[] {
        (Nombre: "Licores", Foto: "caja-licores.webp", Precio: Model.Ajustes.PrecioCombo),
        (Nombre: "Cremas", Foto: "caja-cremas.webp", Precio: Model.Ajustes.PrecioComboCremas)
    }.Where(c => c.Precio > 0).ToArray();
}
<partial name="_Escena" />
<partial name="_Coleccion" model="Model" />
<p class="solo-lectura" data-resultado role="status"></p>
<dialog class="ficha" aria-labelledby="ficha-nombre" data-ficha>
    <div class="ficha-interior">
        <div class="ficha-foto" data-ficha-foto></div>
        <div class="ficha-texto">
            <p class="detalle-categoria" data-ficha-categoria></p>
            <h2 id="ficha-nombre"></h2>
            <p data-ficha-descripcion></p>
            <div class="producto-acciones" data-ficha-acciones></div>
        </div>
        <form method="dialog"><button type="submit" class="cerrar-ficha" aria-label="Cerrar ficha" autofocus>×</button></form>
    </div>
</dialog>
<section class="cajas" id="cajas" aria-labelledby="cajas-titulo">
    <div class="marco seccion">
        <div class="seccion-cabecera">
            <div><h2 id="cajas-titulo">Cuatro sabores,<br /><em>una caja.</em></h2><p>Elige cuatro sabores de una misma colección y arma tu caja.</p>
                @if (cajas.Length > 1)
                {
                    <nav class="indice-cajas" aria-label="Presentaciones de caja">
                        @foreach (var caja in cajas)
                        {
                            <a href="#caja-@caja.Nombre.ToLowerInvariant()">@caja.Nombre</a>
                        }
                    </nav>
                }
            </div>
        </div>
        <div class="cajas-lista">
            @if (cajas.Length == 0)
            {
                <p>Por el momento no hay cajas disponibles.</p>
            }
            @foreach (var caja in cajas)
            {
                <article class="caja" id="caja-@caja.Nombre.ToLowerInvariant()">
                    <img src="~/images/chachawillka/@caja.Foto" alt="Ejemplo de una caja ChachaWillka con cuatro botellas de @caja.Nombre.ToLowerInvariant()" width="1200" height="800" loading="lazy" />
                    <div>
                        <h3>Caja de @caja.Nombre.ToLowerInvariant()</h3>
                        <p>4 unidades · S/ @caja.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</p>
                        @if (Model.Disponible && !personal)
                        {
                            <a class="boton boton-linea" asp-controller="Cesta" asp-action="Combo" asp-route-categoria="@caja.Nombre">Armar mi caja <span aria-hidden="true">↗</span></a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
<section class="marco seccion visita" id="recojo">
    <div><p class="detalle-categoria">Visítanos</p><h2>Nos vemos en<br /><em>Chachapoyas.</em></h2></div>
    <div>
        <h3>Recojo en el local</h3>
        <p>@Model.Ajustes.Direccion</p>
        @if (!string.IsNullOrWhiteSpace(Model.Ajustes.Horario)) { <p>@Model.Ajustes.Horario</p> }
        @if (!string.IsNullOrWhiteSpace(Model.Ajustes.WhatsApp))
        {
            <a class="enlace-flecha" href="https://wa.me/@Model.Ajustes.WhatsApp" target="_blank" rel="noopener noreferrer">Consultar por WhatsApp ↗</a>
        }
    </div>
</section>
