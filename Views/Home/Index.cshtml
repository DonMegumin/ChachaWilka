@model PortadaVM
@{
    ViewData["Title"] = "Licores y cremas de Chachapoyas";
    ViewData["Portada"] = true;
    var personal = User.IsInRole(RolesTienda.Administrador) || User.IsInRole(RolesTienda.Empleado);
    var cajas = new[] {
        (Nombre: "Licores", Foto: "caja-licores.webp", Precio: Model.Ajustes.PrecioCombo),
        (Nombre: "Cremas", Foto: "caja-cremas.webp", Precio: Model.Ajustes.PrecioComboCremas)
    }.Where(c => c.Precio > 0).ToArray();
}
<partial name="_Escena" />
<partial name="_Coleccion" model="Model" />
<partial name="_Ficha" />
<section class="cajas" id="cajas" aria-labelledby="cajas-titulo">
    <div class="marco seccion">
        <div class="seccion-cabecera cajas-cabecera">
            <h2 id="cajas-titulo">Cuatro sabores. <em>Tu caja.</em></h2>
            <p>Combina cuatro botellas de licores o cuatro de cremas. Tú eliges qué va dentro.</p>
        </div>
        <div class="cajas-lista" data-momento-cajas>
            @if (cajas.Length == 0)
            {
                <p>Por el momento no hay cajas disponibles.</p>
            }
            @foreach (var caja in cajas)
            {
                <article class="caja" id="caja-@caja.Nombre.ToLowerInvariant()">
                    <div class="caja-foto">
                        <img src="~/images/chachawillka/@caja.Foto" alt="Presentación referencial de la caja ChachaWillka de @caja.Nombre.ToLowerInvariant()"
                             width="1200" height="800" loading="lazy" />
                    </div>
                    <div class="caja-datos">
                        <div>
                            <h3>Caja de @caja.Nombre.ToLowerInvariant()</h3>
                            <p>4 botellas · S/ @caja.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</p>
                        </div>
                        @if (Model.Disponible && !personal)
                        {
                            <a class="boton boton-linea" asp-controller="Cesta" asp-action="Combo" asp-route-categoria="@caja.Nombre"
                               aria-label="Armar caja de @caja.Nombre.ToLowerInvariant()">Armar caja <span class="flecha" aria-hidden="true"></span></a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
<section class="marco seccion visita" id="recojo" aria-labelledby="recojo-titulo">
    <div>
        <h2 id="recojo-titulo">Recojo en<br /><em>Chachapoyas.</em></h2>
        <div class="datos-recojo">
            <p>@Model.Ajustes.Direccion</p>
            @if (!string.IsNullOrWhiteSpace(Model.Ajustes.Horario))
            {
                <p>@Model.Ajustes.Horario</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Ajustes.WhatsApp))
            {
                <a class="enlace-flecha" href="https://wa.me/@Model.Ajustes.WhatsApp" target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <span class="flecha" aria-hidden="true"></span></a>
            }
        </div>
    </div>
    <details class="guia-recojo"><summary>Cómo recoger mi pedido <span class="flecha" aria-hidden="true"></span></summary>
    <ol class="pasos-recojo">
        <li><h3>Haz tu pedido</h3><p>Elige tus botellas o arma una caja y confirma en la cesta.</p></li>
        <li><h3>Paga con Yape</h3><p>Consulta el importe y envía el comprobante desde tu pedido.</p></li>
        <li><h3>Pasa por el local</h3><p>Cuando tu pedido figure listo, presenta el código del pedido y tu documento.</p></li>
    </ol>
    </details>
</section>
