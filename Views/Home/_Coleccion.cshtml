@model PortadaVM
@{
    var personal = User.IsInRole(RolesTienda.Administrador) || User.IsInRole(RolesTienda.Empleado);
    var completa = ViewData["Catalogo"] is true;
    var destino = completa ? "Coleccion" : "Index";
}
<section class="marco seccion coleccion @(completa ? "catalogo-completo" : "galeria")" id="coleccion" aria-labelledby="coleccion-titulo">
    <div class="seccion-cabecera">
        @if (completa) { <h1 id="coleccion-titulo">La colección.</h1> }
        else
        {
            <h2 id="coleccion-titulo">Explora los sabores.</h2>
            <a class="ver-coleccion" asp-action="Coleccion">Ver toda la colección <span class="flecha" aria-hidden="true"></span></a>
        }
    </div>
    <div class="barra-coleccion">
        <nav class="filtros" aria-label="Filtrar colección">
            <a asp-action="@destino" asp-fragment="coleccion" aria-current="@(Model.Categoria == null ? "true" : null)">Todos</a>
            <a asp-action="@destino" asp-route-categoria="Licores" asp-fragment="coleccion" aria-current="@(Model.Categoria == "Licores" ? "true" : null)">Licores</a>
            <a asp-action="@destino" asp-route-categoria="Cremas" asp-fragment="coleccion" aria-current="@(Model.Categoria == "Cremas" ? "true" : null)">Cremas</a>
        </nav>
        @if (Model.Productos.Count > 0)
        {
            <label class="buscar-sabores" hidden data-busqueda>
                <span class="solo-lectura">Buscar sabor en esta colección</span>
                <input type="search" placeholder="Buscar sabor" autocomplete="off" maxlength="80" />
            </label>
        }
    </div>
    @if (!Model.Disponible)
    {
        <p class="nota">Puedes explorar la colección. La cesta volverá a estar disponible cuando se restablezca la conexión con la tienda.</p>
    }
    @if (Model.Productos.Count == 0)
    {
        <p class="vacio">Por ahora no hay productos en esta colección.</p>
    }
    <p class="vacio" data-sin-resultados hidden>No encontramos ese sabor. Prueba con otro nombre o cambia de colección.</p>
    <div class="productos">
        @foreach (var producto in Model.Productos)
        {
            <article class="producto">
                <div class="producto-foto">
                    <button type="button" class="abrir-ficha" aria-label="Ver ficha de @producto.Nombre" aria-haspopup="dialog" hidden data-abrir-ficha>
                        <span class="flecha" aria-hidden="true"></span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                    {
                        <img src="~/images/chachawillka/@producto.Imagen" alt="@producto.Nombre" width="640" height="585" loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <span class="marca marca-sola" aria-hidden="true">Chacha<i>Willka</i></span>
                    }
                </div>
                <div class="producto-texto">
                    <p class="detalle-categoria">@(producto.Categorias?.Nombre_Categoria ?? producto.Categoria)</p>
                    <h3>@producto.Nombre</h3>
                    <p>@producto.Descripcion</p>
                    <div class="producto-acciones">
                        <strong>S/ @producto.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</strong>
                        @if (Model.Disponible && producto.Disponible > 0 && !personal)
                        {
                            <form asp-controller="Cesta" asp-action="Agregar" method="post">
                                <input type="hidden" name="id" value="@producto.Id_Producto" />
                                <input type="hidden" name="categoria" value="@Model.Categoria" />
                                <button type="submit" class="boton-redondo" aria-label="Añadir @producto.Nombre a la cesta" title="Añadir a la cesta">+</button>
                            </form>
                        }
                        else if (Model.Disponible && producto.Disponible <= 0)
                        {
                            <span class="stock">Sin stock</span>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
    @if (!completa && Model.Productos.Count > 1)
    {
        <div class="controles-galeria" hidden>
            <button type="button" data-avance="-1" aria-label="Sabores anteriores"><span class="flecha" aria-hidden="true"></span></button>
            <button type="button" data-avance="1" aria-label="Sabores siguientes"><span class="flecha" aria-hidden="true"></span></button>
        </div>
    }
</section>
