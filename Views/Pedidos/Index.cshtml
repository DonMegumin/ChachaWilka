@model IReadOnlyList<PedidoResumen>
@{ ViewData["Title"] = "Mis pedidos"; }
<section class="marco pagina">
    <h1>Mis pedidos</h1>
    @if (Model.Count == 0)
    {
        <div class="vacio"><h2>Aún no tienes pedidos.</h2><p>Cuando confirmes tu primera compra podrás seguirla aquí.</p>
        <a class="boton boton-primario" asp-controller="Home" asp-action="Index" asp-fragment="coleccion">Ver la colección ↗</a></div>
    }
    else
    {
        <partial name="_ListaPedidos" model="Model" />
    }
</section>
