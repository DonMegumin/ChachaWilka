@inject CarritoTienda Carrito
@{
    var portada = ViewData["Portada"] is true;
    var catalogo = ViewData["Catalogo"] is true;
    var personal = User.IsInRole(RolesTienda.Administrador) || User.IsInRole(RolesTienda.Empleado);
    var cesta = Carrito.Leer(Context.Session);
    var cantidad = cesta.Botellas.Values.Sum() + cesta.Combos.Count * 4;
}
<!DOCTYPE html>
<html lang="es-PE" data-type="@(portada ? "product" : null)">
<head>
    <meta charset="utf-8" />
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#12251d" />
    <meta name="description" content="Descubre la colección de licores y cremas artesanales de ChachaWillka. Haz tu pedido para recojo en Chachapoyas." />
    <title>@ViewData["Title"] — ChachaWillka</title>
    <link rel="icon" type="image/jpeg" href="~/images/chachawillka/instagram-perfil.jpg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (portada || catalogo)
    {
        <meta name="page-type" content="product" />
        <meta name="site-kind" content="other" />
        <link rel="stylesheet" href="~/css/escaparate.css" asp-append-version="true" />
        <script src="~/js/escaparate.js" asp-append-version="true" defer></script>
    }
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="@(portada ? "es-portada" : "") @(personal && !portada ? "es-personal" : "")">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
        <div class="marco cabecera-interior">
            <a class="marca" asp-controller="Home" asp-action="Index" aria-label="ChachaWillka, inicio">Chacha<i>Willka</i><span>.</span></a>
            <nav class="navegacion" id="menu-principal" aria-label="Navegación principal">
                <a asp-controller="Home" asp-action="Coleccion">Colección</a>
                @if (!personal)
                {
                    <a class="nav-cajas" asp-controller="Home" asp-action="Index" asp-fragment="cajas">Cajas</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="recojo">Recojo</a>
                }
                @if (User.IsInRole(RolesTienda.Administrador))
                {
                    <a asp-controller="Administracion" asp-action="Index">Administración</a>
                }
                else if (User.IsInRole(RolesTienda.Empleado))
                {
                    <a asp-controller="Operacion" asp-action="Index">Operación</a>
                }
                else if (User.IsInRole(RolesTienda.Cliente))
                {
                    <a asp-controller="Pedidos" asp-action="Index">Mis pedidos</a>
                }
            </nav>
            <div class="cuenta-nav">
                <button type="button" class="tema-control" data-tema aria-pressed="false">Modo oscuro</button>
                <button type="button" class="menu-movil" aria-expanded="false" aria-controls="menu-principal" hidden>Menú</button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="boton-sesion" asp-controller="Login" asp-action="Cuenta">Mi cuenta</a>
                    <form asp-controller="Login" asp-action="Logout" method="post"><button class="enlace boton-sesion" type="submit">Salir</button></form>
                }
                else
                {
                    <a class="boton-sesion" asp-controller="Login" asp-action="Login">Ingresar</a>
                }
                @if (!personal)
                {
                    <a class="cesta-nav" data-bolsa-url="@Url.Action("VistaRapida", "Cesta")" asp-controller="Cesta" asp-action="Index"><svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 8h14l1 13H4L5 8Z M9 9V6a3 3 0 0 1 6 0v3" /></svg> Cesta <span>@cantidad</span></a>
                }
            </div>
        </div>
    </header>
    @if (personal && !portada && !catalogo)
    {
        <nav class="nav-personal" aria-label="Área de personal"><div class="marco">
            @if (User.IsInRole(RolesTienda.Administrador))
            {
                <a asp-controller="Administracion" asp-action="Catalogo">Inventario</a>
                <a asp-controller="Administracion" asp-action="Usuarios">Cuentas</a>
                <a asp-controller="Administracion" asp-action="Reportes">Reportes</a>
                <a asp-controller="Administracion" asp-action="Ajustes">Ajustes</a>
            }
            <a asp-controller="Operacion" asp-action="Index">Pedidos del local</a>
        </div></nav>
    }
    <main id="contenido">
        @if (TempData["Aviso"] is string aviso)
        {
            <div class="aviso marco" role="status">@aviso</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="aviso aviso-error marco" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    @if (!personal)
    {
        <dialog class="bolsa" data-bolsa aria-labelledby="titulo-bolsa">
            <header><h2 id="titulo-bolsa">Tu cesta</h2><form method="dialog"><button class="cerrar-capa" aria-label="Cerrar cesta" autofocus>×</button></form></header>
            <p class="bolsa-aviso" role="status"></p>
            <div data-bolsa-contenido></div>
            <a class="bolsa-enlace" asp-controller="Cesta" asp-action="Index">Abrir página de la cesta</a>
        </dialog>
    }
    <footer class="pie">
        <div class="marco pie-interior">
            <div><a class="marca" asp-controller="Home" asp-action="Index">Chacha<i>Willka</i><span>.</span></a><p>Licores y cremas artesanales · Chachapoyas</p></div>
            <nav aria-label="Información de la tienda"><a asp-controller="Home" asp-action="Privacy">Privacidad</a><a href="https://www.instagram.com/chachawillka/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></nav>
            <p class="pie-consumo">Venta para mayores de 18 años.<br />Disfruta con responsabilidad.</p>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
